<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── ZKTeco ADMS biometric device: pass directly through to public/ ───────────
    # IMPORTANT: NO HTTPS redirect for /iclock — ZKTeco firmware cannot follow redirects
    RewriteCond %{REQUEST_URI} ^/iclock [NC]
    RewriteRule ^(.*)$ public/$1 [L]

    # Rewrite all other requests to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
